APP_ENV=local
HTTP_PORT={{ http_port }}
LOG_LEVEL=debug

DATABASE_URL=postgres://{{ project_slug | replace('-', '_') }}:{{ project_slug | replace('-', '_') }}@localhost:5432/{{ project_slug | replace('-', '_') }}?sslmode=disable

NOTIFICATION_BASE_URL=http://localhost:9999
NOTIFICATION_API_KEY=changeme

{% if use_redis %}
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
{% endif %}
{% if use_kafka %}
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP={{ project_slug }}
{% endif %}
{% if use_s3 %}
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET={{ project_slug }}
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
{% endif %}
